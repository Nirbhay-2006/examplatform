{
  "info": {
    "name": "Exam Platform API",
    "description": "Complete API collection for testing Exam Platform",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Student",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"Password123\",\n  \"role\": \"student\"\n}"
            },
            "url": {"raw": "http://localhost:5000/api/auth/register"}
          }
        },
        {
          "name": "Register Teacher",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Teacher Smith\",\n  \"email\": \"teacher@example.com\",\n  \"password\": \"Password123\",\n  \"role\": \"teacher\"\n}"
            },
            "url": {"raw": "http://localhost:5000/api/auth/register"}
          }
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"otpCode\": \"123456\"\n}"
            },
            "url": {"raw": "http://localhost:5000/api/auth/verify-otp"}
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"Password123\"\n}"
            },
            "url": {"raw": "http://localhost:5000/api/auth/login"}
          }
        }
      ]
    },
    {
      "name": "Exam - Teacher",
      "item": [
        {
          "name": "Create Exam",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{teacher_token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Mathematics Final Exam\",\n  \"description\": \"Final exam for semester 6\",\n  \"duration\": 60,\n  \"totalMarks\": 100,\n  \"passingMarks\": 40,\n  \"startTime\": \"2024-12-20T10:00:00Z\",\n  \"endTime\": \"2024-12-20T11:00:00Z\",\n  \"isPaid\": false,\n  \"maxViolations\": 3\n}"
            },
            "url": {"raw": "http://localhost:5000/api/exam"}
          }
        },
        {
          "name": "Add Question",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{teacher_token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"questionText\": \"What is 2 + 2?\",\n  \"questionType\": \"mcq\",\n  \"options\": [\"2\", \"3\", \"4\", \"5\"],\n  \"correctAnswer\": \"4\",\n  \"marks\": 10\n}"
            },
            "url": {"raw": "http://localhost:5000/api/exam/{{exam_id}}/questions"}
          }
        },
        {
          "name": "Get My Exams",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{teacher_token}}"}],
            "url": {"raw": "http://localhost:5000/api/exam/teacher/my-exams"}
          }
        },
        {
          "name": "Assign Exam",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{teacher_token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "[\"{{student_id}}\"]"
            },
            "url": {"raw": "http://localhost:5000/api/exam/{{exam_id}}/assign"}
          }
        }
      ]
    },
    {
      "name": "Exam - Student",
      "item": [
        {
          "name": "Get My Exams",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{student_token}}"}],
            "url": {"raw": "http://localhost:5000/api/exam/student/my-exams"}
          }
        },
        {
          "name": "Start Exam",
          "request": {
            "method": "POST",
            "header": [{"key": "Authorization", "value": "Bearer {{student_token}}"}],
            "url": {"raw": "http://localhost:5000/api/exam/{{exam_id}}/start"}
          }
        },
        {
          "name": "Get Questions",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{student_token}}"}],
            "url": {"raw": "http://localhost:5000/api/exam/{{exam_id}}/questions"}
          }
        },
        {
          "name": "Submit Answer",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{student_token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"questionId\": \"{{question_id}}\",\n  \"answer\": \"4\"\n}"
            },
            "url": {"raw": "http://localhost:5000/api/exam/{{exam_id}}/answer"}
          }
        },
        {
          "name": "Report Violation",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{student_token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"examId\": \"{{exam_id}}\",\n  \"violationType\": \"tab_switch\"\n}"
            },
            "url": {"raw": "http://localhost:5000/api/exam/{{exam_id}}/violation"}
          }
        },
        {
          "name": "Submit Exam",
          "request": {
            "method": "POST",
            "header": [{"key": "Authorization", "value": "Bearer {{student_token}}"}],
            "url": {"raw": "http://localhost:5000/api/exam/{{exam_id}}/submit"}
          }
        }
      ]
    },
    {
      "name": "Results",
      "item": [
        {
          "name": "Publish Results (Teacher)",
          "request": {
            "method": "POST",
            "header": [{"key": "Authorization", "value": "Bearer {{teacher_token}}"}],
            "url": {"raw": "http://localhost:5000/api/result/{{exam_id}}/publish"}
          }
        },
        {
          "name": "Get My Results (Student)",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{student_token}}"}],
            "url": {"raw": "http://localhost:5000/api/result/my-results"}
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Get Dashboard",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{admin_token}}"}],
            "url": {"raw": "http://localhost:5000/api/admin/dashboard"}
          }
        },
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{admin_token}}"}],
            "url": {"raw": "http://localhost:5000/api/admin/users"}
          }
        }
      ]
    },
    {
      "name": "Payment",
      "item": [
        {
          "name": "Create Order",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{student_token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "499.00"
            },
            "url": {"raw": "http://localhost:5000/api/payment/create-order"}
          }
        },
        {
          "name": "Verify Payment",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{student_token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"order_xxx\",\n  \"paymentId\": \"pay_xxx\"\n}"
            },
            "url": {"raw": "http://localhost:5000/api/payment/verify"}
          }
        }
      ]
    }
  ]
}
