    "/api/Teacher/CreateCourse/create": {
      "post": {
        "tags": [
          "Teacher"
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "Title": {
                    "type": "string"
                  },
                  "Description": {
                    "type": "string"
                  },
                  "Fees": {
                    "type": "number",
                    "format": "float"
                  },
                  "StartDate": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "EndDate": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "ThumbailUrl": {
                    "type": "string",
                    "format": "binary"
                  },
                  "Files": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "binary"
                    }
                  }
                }
              },
              "encoding": {
                "Title": {
                  "style": "form"
                },
                "Description": {
                  "style": "form"
                },
                "Fees": {
                  "style": "form"
                },
                "StartDate": {
                  "style": "form"
                },
                "EndDate": {
                  "style": "form"
                },
                "ThumbailUrl": {
                  "style": "form"
                },
                "Files": {
                  "style": "form"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
